* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #172033;
    line-height: 1.6;
}

header {
    background: linear-gradient(135deg, #073b7a, #1769aa);
    color: white;
    text-align: center;
    padding: 55px 20px;
}

header h1 {
    font-size: 42px;
    margin: 10px;
}

main {
    width: 90%;
    max-width: 1100px;
    margin: auto;
}

section {
    margin: 40px 0;
}

h2 {
    color: #073b7a;
}

.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 18px;
}

.cards > div,
.case,
.question {
    background: white;
    padding: 22px;
    border-radius: 12px;
    box-shadow: 0 4px 15px #00000012;
}

.cards h3 {
    color: #1769aa;
}

li {
    margin: 8px 0;
}

.case {
    margin: 18px 0;
    border-left: 5px solid #1769aa;
}

.question {
    margin: 20px 0;
}

.question label {
    display: block;
    margin: 10px 0;
}

button {
    background: #1769aa;
    color: white;
    border: none;
    padding: 12px 25px;
    border-radius: 7px;
    cursor: pointer;
    font-weight: bold;
}

button:hover {
    background: #073b7a;
}

#result {
    font-size: 20px;
    font-weight: bold;
}

footer {
    background: #172033;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 50px;
}
