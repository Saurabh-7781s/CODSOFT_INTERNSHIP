from collections import Counter
from pathlib import Path

from flask import Flask, render_template_string


app = Flask(__name__)

LOG_FILE = Path(__file__).with_name("sample_alerts.log")


HTML = """
<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>IDS Alert Dashboard</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 30px;
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #172033;
}

.container {
    max-width: 1100px;
    margin: auto;
}

h1 {
    color: #123c69;
    margin-bottom: 30px;
}

.cards {
    display: grid;
    grid-template-columns:
        repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
}

.card {
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.08);
}

.card h2 {
    color: #1769aa;
    font-size: 32px;
}

table {
    width: 100%;
    margin-top: 30px;
    border-collapse: collapse;
    background: white;
    border-radius: 10px;
    overflow: hidden;
}

th {
    background: #123c69;
    color: white;
}

th,
td {
    padding: 14px;
    border-bottom: 1px solid #ddd;
    text-align: left;
}

tr:hover {
    background: #f1f5f9;
}

@media (max-width: 700px) {

    body {
        padding: 15px;
    }

    table {
        font-size: 12px;
    }

}

</style>

</head>


<body>

<div class="container">

<h1>Network Intrusion Detection Dashboard</h1>


<div class="cards">

<div class="card">

<p>Total Alerts</p>

<h2>{{ total }}</h2>

</div>


<div class="card">

<p>Unique Signatures</p>

<h2>{{ signatures }}</h2>

</div>


<div class="card">

<p>Source IP Addresses</p>

<h2>{{ sources }}</h2>

</div>

</div>


<table>

<thead>

<tr>

<th>Time</th>

<th>SID</th>

<th>Alert</th>

<th>Source IP</th>

<th>Destination IP</th>

</tr>

</thead>


<tbody>

{% for row in rows %}

<tr>

<td>{{ row[0] }}</td>

<td>{{ row[1] }}</td>

<td>{{ row[2] }}</td>

<td>{{ row[3] }}</td>

<td>{{ row[4] }}</td>

</tr>

{% endfor %}

</tbody>

</table>

</div>

</body>

</html>
"""


def load_alerts():

    alerts = []

    if not LOG_FILE.exists():
        return alerts

    lines = LOG_FILE.read_text(
        encoding="utf-8"
    ).splitlines()

    for line in lines:

        parts = line.split("|")

        if len(parts) == 5:
            alerts.append(parts)

    return alerts


@app.route("/")
def dashboard():

    alerts = load_alerts()

    signatures = Counter(
        alert[1]
        for alert in alerts
    )

    sources = Counter(
        alert[3]
        for alert in alerts
    )

    return render_template_string(

        HTML,

        rows=alerts,

        total=len(alerts),

        signatures=len(signatures),

        sources=len(sources)

    )


if __name__ == "__main__":

    app.run(
        host="127.0.0.1",
        port=5050,
        debug=False
    )
